{
  "id": "../home.html",
  "name": "WeatherBoy Radar",
  "short_name": "WeatherBoy",
  "description": "WeatherBoy Radar: live Florida weather radar, storm tracking and alerts centered on Tampa.",
  "start_url": "../home.html",
  "scope": "../",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "categories": ["weather"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-180.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Live radar", "url": "../index.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Lightning", "url": "../index.html?show=lightning", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "24-hour forecast", "url": "../forecast.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
